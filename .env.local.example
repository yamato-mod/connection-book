# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production raw OCR display requires both this flag and ?debug=ocr.
NEXT_PUBLIC_ENABLE_OCR_DEBUG=false

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
MAIL_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters

# Shared club Google account OAuth 2.0 (server only)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# 32 random bytes encoded as base64. Server only; used for AES-256-GCM.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# At least 32 random characters. Server only; signs OAuth state.
GOOGLE_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
GOOGLE_REFRESH_TOKEN=xxx
GOOGLE_SHARED_GMAIL=club@example.jp
GOOGLE_DRIVE_FOLDER_ID=xxx
GOOGLE_CALENDAR_ID=primary
